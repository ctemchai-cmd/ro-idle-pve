    "revision_conflict",
    "inventory_full",
    "incompatible_version",
    "recovery_preview"
  ],
  "network_cases": [
    {
      "id": "offline_cannot_claim",
      "state": "disconnected",
      "action": "farm.claim",
      "allowed": false
    },
    {
      "id": "pending_no_double_gacha",
      "state": "command_pending",
      "action": "gacha.pull",
      "allowed": false
    },
    {
      "id": "ready_can_upgrade",
      "state": "ready",
      "action": "skill.upgrade",
      "allowed": true
    },
    {
      "id": "expired_cannot_spend",
      "state": "session_expired",
      "action": "slot.refine",
      "allowed": false
    },
    {
      "id": "conflict_cannot_overwrite",
      "state": "revision_conflict",
      "action": "party.set",
      "allowed": false
    },
    {
      "id": "offline_can_mute",
      "state": "disconnected",
      "action": "settings.local",
      "allowed": true
    },
    {
      "id": "inventory_full_can_free_space",
      "state": "inventory_full",
      "action": "equipment.salvage",
      "allowed": true
    }

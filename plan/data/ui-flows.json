    },
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 844,
      "height": 390
    },
    {
      "width": 1280,
      "height": 720
    }
  ],
  "layout_rules": {
    "minimum_width": 360,
    "tap_target": 44,
    "text_body": 14,
    "text_secondary": 12,
    "four_slot_gaps": 8,
    "horizontal_padding": 16
  },
  "manual_flows": [
    {
      "id": "team_unique_roots",
      "input": "mainMage + NPCSword/NPCSword/NPCAco",
      "expected": "reject duplicate NPC root; main duplicate allowed with a different NPC selection"
    },
    {
      "id": "insufficient_upgrade",
      "input": "level upgrade wallet short",
      "expected": "show missing resources; wallet and level unchanged"
    },
    {
      "id": "response_lost",
      "input": "gacha command committed, response lost",
      "expected": "lookup/retry same request ID; display same instances once"
    },
    {
      "id": "daily_midnight",
      "input": "battle ticket19 finishes day20",
      "expected": "show old ticket day; do not overwrite new-day attempts"
    },
    {
      "id": "inventory_reward_pending",
      "input": "inventory full at clear",
      "expected": "pending fixed claim, open inventory then replay same claim"
    },
    {
      "id": "tutorial_skip",
      "input": "skip first Status tutorial",
      "expected": "no required point spending, party stays valid"
    },
    {
      "id": "recovery_old_backup",
      "input": "local revision4 cloud revision8",
      "expected": "cloud wins; backup readable/exportable; no currency merge"
    }
  ],
  "durable_state_exceptions": {
    "inventory_full": [
      "equipment.salvage",
      "equipment.fuse",
      "card.salvage",
      "equipment.lock"
    ]
  }

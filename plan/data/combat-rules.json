    "battle_end": "cancel_all_casts_events_statuses_shields_and_summons; preserve_durable_account_only"
  },
  "event_order": {
    "time_domain": "integer ms and explicit sequence; independent of renderer FPS",
    "timeout_boundary": "time >= battle_limit: timeout before events_at_that_timestamp",
    "phases": [
      "expire_status_and_shield_instances",
      "periodic_regen_and_status_ticks_then_commit_deaths",
      "lock_all_valid_existing_cast_completions_at_this_timestamp",
      "resolve_locked_cast_programs_in_actor_id_action_id_order",
      "drain_reactions_then_commit_deaths_and_check_terminal_result",
      "start_ready_skills_in_actor_id_order_including_zero_CT_resolve",
      "normal_attacks_in_actor_id_order",
      "drain_reactions_commit_deaths_check_result_schedule_next_time"
    ],
    "cast_completion_batch": "locked completers emit even if killed/interrupted by another locked completer; HP0 is ineligible for ordinary heal; death reactions/cleanup commit at phase barrier",
    "zero_CT": "start-and-resolve in ready-skill phase; still spends_SP/slot and suppresses coincident_normal",
    "interrupt_at_cast_completion_same_time": "too_late_if_cast_already_locked_in_completion_batch",
    "periodic_at_expiry": "expire_first; tick_only_if_scheduled_time_strictly_before_expiry",
    "root_program_reactions": "enqueue_during_program; drain_at_phase_boundary, not JS callback order",
    "death": "invalidate_remaining_nonlocked_casts; no_SP_refund",
    "simultaneous_team_wipe": "loss_for_player",
    "initial_tie_breaker": "stable actor_id, action_id, effect_order, target_id, hit_index, event_sequence",
    "target_liveness": "HP > 0 for normal targeting/healing; locked caster admission is retained only for the admitted completion program"
  },
  "rng": {
    "algorithm": "lcg32-v1",
    "a": 1664525,
    "c": 1013904223,
    "modulus": 4294967296,
    "seed_range": [
      0,
      4294967295
    ],
    "draw": "state=(a*state+c) mod 2^32; u=state/2^32",
    "typescript_math": "Math.imul(a,state) and unsigned >>>0",
    "order": "target_selection_if_random -> hit -> eligible_crit -> effect_chance per ordered_effect/target/hit",
    "state_fields": [
      "state_uint32",
      "draw_count"
    ],
    "no_draw_for": "predicate_false, invalid/dead_skipped_target, ineligible_crit",
    "attempted_probability_even_zero_or_one_consumes_draw": true
  },

    "positive_aggregate_buff_cap": null
  },
  "combat_probabilities": {
    "physical_hit": "clamp(0.95+0.002*(caster.dex-target.agi)+0.001*(caster.luk-1)+hit_bonus-evasion_bonus,0,1)",
    "magical_hit_default": 1,
    "crit_chance": "clamp(0.05+0.008*(caster.luk-1)+crit_chance_bonus-0.003*(target.luk-1)-target_crit_resistance,0,1)",
    "crit_multiplier": "max(1,1.5+0.005*(caster.luk-1)+crit_damage_bonus)",
    "crit_ignores_defense": false,
    "default_crit_eligibility": {
      "normal_attack": true,
      "physical_skill": true,
      "magical_skill": false,
      "dot": false,
      "hot": false,
      "heal": false,
      "reflect": false
    },
    "default_hit_roll": "per_target_per_hit",
    "default_crit_roll": "per_landed_eligible_hit",
    "guaranteed_chance_roll_consumes_rng": true,
    "control_apply_chance": "clamp(effect_base_chance+control_accuracy-target_control_resistance,0,1); no_base_duration_reduction"
  },
  "damage_pipeline": [
    "resolve_caster_primary_and_derived_sources",
    "raw=attack_stat*coefficient+flat_power_per_hit",
    "outgoing=max(0,1+sum_outgoing_bonus)",
    "element=attack_vs_defense_chart",
    "hit_then_crit_if_eligible",
    "effective_defense=max(0,max(0,target_defense*(1-armor_break))*(1-penetration_percent)-flat_penetration)",
    "armor_multiplier=1-0.9*effective_defense/(effective_defense+400)",
    "flat_reduction=max(0,power_after_armor-flat_damage_reduction)",
    "guard=max(0,1-sum_guard_percent)",
    "vulnerability=max(0,1+sum_damage_taken_percent)",
    "round_hp_amount_once",
    "route_devotion_transfer_once_before_shields",
    "shield_absorb",
    "effective_hp_loss=min(current_hp,remaining_damage)",
    "metrics_overkill_separate"
  ],
  "armor": {
    "k": 400,
    "asymptotic_reduction": 0.9,
    "negative_defense_allowed": false,
    "physical_uses": "physical_defense",
    "magical_uses": "magical_defense",
    "guard_aggregation_cap": null,
    "guard_at_or_above_one": "zero_damage_multiplier; contributions remain uncapped",
    "armor_break_policy_owner": "TASK-047"
  },
  "healing": {
    "formula": "floor(max(0,healing_stat*coefficient+flat_heal)*max(0,1+outgoing_heal_bonus)*max(0,1+healing_received_bonus)+1e-9)",
    "effective_heal": "min(max_hp-current_hp,raw_heal)",
    "overheal": "raw_heal-effective_heal",
    "default_crit": false,
    "dead_target": "skip unless explicit revive operation"
  },
  "resources": {
    "spend_skill_sp": "once_at_cast_start",
    "insufficient_sp": "skip_current_slot_then_next_skill_interval",
    "interrupted_refund": false,
    "sp_regen_interval_ms": 1000,
    "sp_regen_formula": "floor(max(0,2+0.02*max_sp+0.02*(int-1)+flat_sp_regen)*max(0,1+sp_regen_percent))",
    "hp_regen_interval_ms": 1000,
    "natural_hp_regen": 0,
    "hp_regen_formula": "floor(max(0,flat_hp_regen+max_hp*hp_regen_percent))",
    "regen_allowed_while_cast_or_cc": true,
    "dead_actor_regen": false,
    "new_battle_hp_sp": "full"

    "interruptible": "skill_definition_flag default true; direct_interrupt_and_CC_cancel_only_if_true; normal_damage_does_not_interrupt_by_itself",
    "uninterruptible_cast_under_CC": "continues_CT_and_can_resolve_if_alive; new_actions_still_blocked_by_CC"

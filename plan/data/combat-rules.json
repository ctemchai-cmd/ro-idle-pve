    "guards": {
      "max_events_per_fight": 1000000,
      "max_reaction_depth": 32,
      "on_exceeded": "diagnostic_error_with_seed_versions_input; do_not_drop_effects_to_make_success"
    },
    "reference_balance": "M0 arithmetic sensitivity, M1 runtime_parity, M4 measured_balance",
    "checkpoint_field_mapping": {
      "game_time_ms": "game_time_ms",
      "phase": "phase",
      "actor_state": "actors",
      "cast_tokens": "actors[].cast.token",
      "event_sequence": "event_sequence",
      "paused_normal_remaining_ms": "actors[].normal_clock.remaining_ms",
      "pending_events": "pending_events",
      "phase_ready_at": "actors[].phase_ready_at",
      "rng_state": "rng",
      "rotation_cursor": "actors[].rotation_cursor",
      "shield_pools": "actors[].shields",
      "status_instances": "actors[].statuses"
    }
  },
  "damage_redirect": {
    "stage": "after rounded mitigation before target shields",
    "eligibility": "live other actor on same team only; source_death removes link",
    "aggregation": "sum independent fractions without cap; conserve original damage, proportional allocation if total fraction exceeds one",
    "allocation": "total=min(P,floor(P*sumRatio)); floor proportional shares, distribute remaining points by instance ID; one routing pass",
    "transfer": "recipient shields then HP; no second armor/crit/guard; origin transfer cannot redirect/reflect/proc unless a trigger explicitly accepts it",
    "attribution": "original attacker/action plus redirecting status source; no damage creation"
  },

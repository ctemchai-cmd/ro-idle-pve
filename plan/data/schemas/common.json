{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ro-idle.local/schemas/common.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "level_param": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "level_param"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status_param": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "status_param"
          ],
          "additionalProperties": false
        }
      ]
    },
    "nonnegative_scalar": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "properties": {
            "level_param": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "level_param"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status_param": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "status_param"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ro-idle.local/schemas/predicate.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "all"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "predicate.json"
          }
        }
      },
      "required": [
        "type",
        "conditions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "any"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "predicate.json"
          }
        }
      },
      "required": [
        "type",
        "conditions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "not"
        },
        "condition": {
          "$ref": "predicate.json"
        }
      },
      "required": [
        "type",
        "condition"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "hit_landed"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scope": {
          "const": "same_target"
        },
        "hit_index": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "any"
            }
          ]
        }
      },
      "required": [
        "type",
        "effect_id",
        "scope",
        "hit_index"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "has_status"
        },
        "actor": {
          "enum": [
            "self",
            "target",
            "event_source",
            "event_target"
          ]
        },
        "status_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "type",
        "actor",
        "status_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "hp_below"
        },
        "actor": {
          "enum": [
            "self",
            "target",
            "event_source",
            "event_target"
          ]
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "actor",
        "ratio"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "resource_at_least"
        },
        "actor": {
          "enum": [
            "self",
            "target"
          ]
        },
        "resource": {
          "enum": [
            "sp",
            "spirit_spheres"
          ]
        },
        "amount": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "object",
              "properties": {
                "level_param": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "level_param"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status_param": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "required": [
                "status_param"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "type",
        "actor",
        "resource",
        "amount"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "has_tag"
        },
        "actor": {
          "enum": [
            "self",
            "target",
            "event_source",
            "event_target"
          ]
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "type",
        "actor",
        "tag"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "effect_succeeded"
        },
        "effect_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "scope": {
          "const": "same_target"
        }
      },
      "required": [
        "type",
        "effect_id",
        "scope"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "stat_compare"
        },
        "actor": {
          "enum": [
            "self",
            "target",
            "event_source",
            "event_target"
          ]
        },
        "left": {
          "enum": [
            "physical_attack",
            "magical_attack"
          ]
        },
        "right": {
          "enum": [
            "physical_attack",
            "magical_attack"
          ]
        },
        "op": {
          "enum": [
            "gt",
            "gte"
          ]
        }
      },
      "required": [
        "type",
        "actor",
        "left",
        "right",
        "op"
      ],
      "additionalProperties": false
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ro-idle.local/schemas/item.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "kind": {
      "enum": [
        "equipment",
        "card"
      ]
    },
    "slot": {
      "enum": [
        "weapon",
        "head",
        "armor",
        "garment",
        "shoes",
        "accessory"
      ]
    },
    "weapon_type": {
      "enum": [
        "sword",
        "bow",
        "staff",
        "book",
        "knuckle",
        "axe",
        "mace",
        "dagger",
        "whip",
        "instrument",
        null
      ]
    },
    "tier_level": {
      "type": "integer",
      "enum": [
        1,
        20,
        40,
        60,
        80,
        100
      ]
    },
    "required_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "modifier.json"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "trigger.json"
      }
    },
    "presentation_id": {
      "type": "string",
      "minLength": 1
    },
    "defense_element": {
      "enum": [
        "neutral",
        "water",
        "earth",
        "fire",
        "wind",
        "poison",
        "holy",
        "dark",
        "ghost",
        "undead"
      ]
    },
    "combat_bonuses": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/combat_bonus"
      }
    }
  },
  "required": [
    "id",
    "name_key",
    "kind",
    "slot",
    "weapon_type",
    "tier_level",
    "required_level",
    "modifiers",
    "triggers"
  ],
  "additionalProperties": false,
  "$defs": {
    "combat_bonus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "damage_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "physical",
              "magical",
              "true"
            ]
          }
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "skill",
              "normal",
              "periodic",
              "proc",
              "reflect",
              "system",
              "transfer"
            ]
          }
        },
        "skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "damage_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "penetration_bonus": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "id",
        "damage_types",
        "origins"
      ],
      "anyOf": [
        {
          "required": [
            "damage_bonus"
          ]
        },
        {
          "required": [
            "penetration_bonus"
          ]
        }
      ],
      "additionalProperties": false
    }
  }
}

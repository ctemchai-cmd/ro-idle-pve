{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ro-idle.local/schemas/receipt.json",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "committed",
        "rejected"
      ]
    },
    "committed_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "server_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "rules_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "result": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "resource_delta": {
          "type": "object",
          "properties": {
            "gold": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "hero_exp": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "skill_manual": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "refine_ore": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "breakthrough_essence": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "enchant_dust": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "card_dust": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "crystal": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "awakening_shard": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "gold",
            "hero_exp",
            "skill_manual",
            "refine_ore",
            "breakthrough_essence",
            "enchant_dust",
            "card_dust",
            "crystal"
          ],
          "additionalProperties": false
        },
        "created_instance_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "removed_instance_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "pending_claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "battle_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          ]
        },
        "reason_key": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          ]
        },
        "ledger_entry_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "refunded_ledger_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "character_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "feature_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "skill_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                ]
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "cost_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "paid_resources": {
                "type": "object",
                "properties": {
                  "gold": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "hero_exp": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "skill_manual": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "refine_ore": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "breakthrough_essence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "enchant_dust": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "card_dust": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "crystal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "awakening_shard": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "gold",
                  "hero_exp",
                  "skill_manual",
                  "refine_ore",
                  "breakthrough_essence",
                  "enchant_dust",
                  "card_dust",
                  "crystal"
                ],
                "additionalProperties": false
              },
              "refund_state": {
                "enum": [
                  "active",
                  "refunded"
                ]
              },
              "refund_command_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                ]
              },
              "cost_versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "entry_id",
              "character_id",
              "feature_id",
              "skill_id",
              "quantity",
              "cost_version",
              "paid_resources",
              "refund_state",
              "refund_command_id",
              "cost_versions"
            ],
            "additionalProperties": false
          }
        },
        "refine_batch": {
          "type": "object",
          "properties": {
            "character_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "slot": {
              "enum": [
                "weapon",
                "head",
                "armor",
                "garment",
                "shoes",
                "accessory"
              ]
            },
            "from_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "to_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "target_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "successes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failures": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stop_reason": {
              "enum": [
                "target_reached",
                "insufficient_resources"
              ]
            }
          },
          "required": [
            "character_id",
            "slot",
            "from_level",
            "to_level",
            "target_level",
            "attempts",
            "successes",
            "failures",
            "stop_reason"
          ],
          "additionalProperties": false
        },
        "option_batch": {
          "type": "object",
          "properties": {
            "item_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "option_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "target_option_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "stones_spent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "original": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "roll": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "id",
                "roll"
              ],
              "additionalProperties": false
            },
            "replacement": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "roll": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "id",
                "roll"
              ],
              "additionalProperties": false
            },
            "stop_reason": {
              "enum": [
                "target_reached",
                "insufficient_stones",
                "attempt_limit"
              ]
            }
          },
          "required": [
            "item_instance_id",
            "option_index",
            "target_option_id",
            "attempts",
            "stones_spent",
            "original",
            "replacement",
            "stop_reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "resource_delta",
        "created_instance_ids",
        "removed_instance_ids",
        "pending_claim_ids",
        "battle_id",
        "reason_key",
        "ledger_entry_ids",
        "refunded_ledger_entries"
      ],
      "additionalProperties": false
    },
    "command_type": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "request_id",
    "request_hash",
    "outcome",
    "committed_revision",
    "server_at",
    "content_version",
    "rules_version",
    "result",
    "command_type",
    "content_hash",
    "schema_version"
  ],
  "additionalProperties": false
}

  "canonical_definition_source": "plan/data authored JSON; build selects files and emits generated immutable bundle with source hashes, no handwritten duplicate in SQL",
  "battle_actors": "array of stable IDs, owner/source/life_epoch; party-size validation belongs to build, not combat iteration",
  "snapshot_boundary": "advanceUntil returns only after full timestamp/reaction barrier; no partial effect program checkpoint"
}

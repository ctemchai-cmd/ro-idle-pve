    "card.assign",
    "card.unassign",
    "card.upgrade",
    "card.salvage",
    "farm.set_stage",
    "farm.claim",
    "reward.claim",
    "battle.start_story",
    "battle.start_tower",
    "battle.start_daily",
    "battle.advance",
    "battle.finish",
    "battle.retreat",
    "daily.objective_claim",
    "gacha.pull",
    "backup.restore_request",

{
  "schema_version": 1,
  "modules": {
    "content": {
      "path": "src/content",
      "imports": [],
      "public": [
        "validateContent",
        "loadValidatedContent",
        "resolveAliases"
      ]
    },
    "math": {
      "path": "src/domain/math",
      "imports": [
        "content"
      ],
      "public": [
        "resolveStats",
        "calculateDamage",
        "skillIntervalMs",
        "castDurationMs"
      ]
    },
    "build": {
      "path": "src/domain/build",
      "imports": [
        "content",
        "math"
      ],
      "public": [
        "compileBuild",
        "applySkillPatches",
        "validateParty"
      ]
    },
    "combat": {
      "path": "src/domain/combat",
      "imports": [
        "content",
        "math",
        "build"
      ],
      "public": [
        "createBattle",
        "advanceUntil",
        "serializeBattle",
        "restoreBattle"
      ]
    },
    "modes": {
      "path": "src/domain/modes",
      "imports": [
        "content",
        "combat"
      ],
      "public": [
        "createEncounter",
        "continueDailyPhase",
        "classifyResult"
      ]
    },
    "progression": {
      "path": "src/domain/progression",
      "imports": [
        "content",
        "math",
        "build"
      ],
      "public": [
        "quoteUpgrade",
        "allocateStats",
        "refundPaidLedger"
      ]
    },
    "rewards": {
      "path": "src/domain/rewards",
      "imports": [
        "content",
        "build"
      ],
      "public": [
        "calculateFarmClaim",
        "rollGacha",
        "buildFixedLoot"
      ]
    },
    "account": {
      "path": "src/domain/account",
      "imports": [
        "content",
        "build",
        "combat",
        "modes",
        "progression",
        "rewards"
      ],
      "public": [
        "decideCommand",
        "validateAccount"
      ]
    },
    "simulation": {
      "path": "src/simulation",
      "imports": [
        "content",
        "build",
        "combat",
        "modes",
        "progression",
        "rewards"
      ],
      "public": [
        "runScenario",
        "runMatchedBatch",
        "replayBattle"
      ]
    },
    "client": {
      "path": "src/client",
      "imports": [
        "content",
        "math",
        "build",
        "combat",
        "modes",
        "progression",
        "rewards"
      ],
      "public": [
        "predictBattle",
        "previewBuild"
      ]
    },
    "ui": {
      "path": "src/ui",
      "imports": [
        "client",
        "renderer"
      ],
      "public": [
        "renderGame"
      ]
    },
    "renderer": {
      "path": "src/renderer",
      "imports": [
        "contracts"
      ],
      "public": [
        "drawBattleView",
        "playPresentationEvent"
      ]
    },
    "api": {
      "path": "api/index.ts",
      "imports": [
        "account",
        "persistence",
        "auth"
      ],
      "public": [
        "fetch"
      ]
    },
    "persistence": {
      "path": "src/server/persistence",
      "imports": [
        "contracts"
      ],
      "public": [
        "readAccount",
        "lookupReceipt",
        "commitCommand"
      ]
    },
    "contracts": {
      "path": "src/contracts",
      "imports": [],
      "public": [
        "Command",
        "Receipt",
        "AccountState",
        "BattleInput",
        "BattleState",
        "BattleEvent",
        "Scenario",
        "Metrics"
      ]
    },
    "auth": {
      "path": "src/server/auth",
      "imports": [
        "contracts"
      ],
      "public": [
        "authenticateRequest"
      ]
    }
  },
  "pure_modules": [
    "content",
    "math",
    "build",
    "combat",
    "modes",
    "progression",
    "rewards",
    "account",
    "simulation",
    "contracts"
  ],
  "forbidden_pure_imports": [
    "react",
    "window",
    "document",
    "canvas",
    "supabase",
    "fetch",
    "Date.now",
    "Math.random",
    "node:fs",
    "node:crypto"
